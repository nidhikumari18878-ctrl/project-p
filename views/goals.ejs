<!DOCTYPE html><html lang="en"><head><title>Goals — Placement Tracker</title><%- include('partials/head') %></head>
<body class="app-bg bg-black text-white min-h-screen"><div class="flex min-h-screen"><%- include('partials/sidebar') %><div class="flex-1 min-w-0"><%- include('partials/mobileNav') %><main class="max-w-6xl mx-auto p-5 sm:p-8 lg:p-10">
<header data-reveal class="flex flex-col md:flex-row md:items-end justify-between gap-5 mb-8"><div><p class="text-violet-300 text-sm font-semibold uppercase tracking-[.18em]">Placement goals</p><h1 class="text-3xl sm:text-4xl font-extrabold mt-2">Turn consistency into progress 🎯</h1><p class="text-gray-500 mt-2">Set measurable application and interview targets.</p></div></header>
<% if (query && query.success) { %><div data-toast class="toast mb-5 rounded-2xl border border-emerald-500/20 bg-emerald-500/10 text-emerald-300 px-4 py-3 text-sm">Goal updated successfully.</div><% } %>
<div class="grid lg:grid-cols-[.8fr_1.2fr] gap-6"><section data-reveal class="glass rounded-3xl p-6"><h2 class="text-xl font-bold">Create a goal</h2><form action="/goals" method="POST" class="space-y-4 mt-5"><input required name="title" class="field" placeholder="Apply to 20 companies" /><div class="grid grid-cols-2 gap-3"><input required min="1" type="number" name="target" class="field" placeholder="Target" /><select name="type" class="field"><option value="applications">Applications</option><option value="interviews">Interviews</option><option value="custom">Custom</option></select></div><input type="date" name="deadline" class="field" /><button class="w-full rounded-2xl py-3 bg-gradient-to-r from-violet-600 to-fuchsia-600 font-bold">Create goal</button></form></section>
<section class="space-y-4"><% if (!goals.length) { %><div data-reveal class="glass rounded-3xl p-10 text-center text-gray-500">No active goals yet. Create one and start your streak.</div><% } %><% goals.forEach((goal) => { %><article data-reveal class="glass rounded-3xl p-5"><div class="flex justify-between gap-4"><div><h3 class="font-bold"><%= goal.title %></h3><p class="text-xs text-gray-500 mt-1"><%= goal.deadline ? 'Deadline: '+new Date(goal.deadline).toLocaleDateString('en-IN') : 'No deadline' %></p></div><form action="/goals/<%= goal._id %>/delete" method="POST"><button class="text-xs text-red-300 hover:text-red-200">Remove</button></form></div><div class="flex justify-between text-sm mt-5"><span class="text-gray-400"><%= goal.current %> / <%= goal.target %></span><span class="text-violet-300 font-semibold"><%= goal.percent %>%</span></div><div class="h-2 bg-white/5 rounded-full overflow-hidden mt-2"><div class="h-full progress-sheen bg-gradient-to-r from-violet-500 to-fuchsia-500 rounded-full" style="width:<%= goal.percent %>%"></div></div></article><% }) %></section></div>
</main></div></div><style>.field{width:100%;background:rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.1);border-radius:1rem;padding:.85rem 1rem;color:white;outline:none}.field:focus{border-color:#8b5cf6}</style><script src="/javascripts/script.js"></script></body></html>
