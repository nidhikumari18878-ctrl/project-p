<!DOCTYPE html><html lang="en"><head><title>Opportunities — Placement Tracker</title><%- include('partials/head') %></head>
<body class="app-bg bg-black text-white min-h-screen"><div class="flex min-h-screen"><%- include('partials/sidebar') %><div class="flex-1 min-w-0"><%- include('partials/mobileNav') %><main class="max-w-7xl mx-auto p-5 sm:p-8 lg:p-10">
<header data-reveal class="flex flex-col lg:flex-row lg:items-end justify-between gap-5 mb-8"><div><p class="text-violet-300 text-sm font-semibold uppercase tracking-[.18em]">Opportunity hub</p><h1 class="text-3xl sm:text-4xl font-extrabold mt-2">Find your next opportunity</h1><p class="text-gray-500 mt-2">Search jobs and internships by company, role, location or skill.</p></div><a href="/fetch-jobs" class="btn-shine px-5 py-3 rounded-2xl bg-gradient-to-r from-violet-600 to-fuchsia-600 font-semibold">↻ Import fresh jobs</a></header>
<% if (query && query.imported) { %><div data-toast class="toast mb-5 rounded-2xl border border-emerald-500/20 bg-emerald-500/10 text-emerald-300 px-4 py-3 text-sm"><%= query.imported %> opportunities imported or refreshed.</div><% } %>
<form method="GET" action="/opportunities" class="glass rounded-3xl p-4 mb-7"><div class="flex flex-col sm:flex-row gap-3"><input name="search" value="<%= search || '' %>" class="flex-1 bg-black/30 border border-white/10 rounded-2xl px-5 py-3 outline-none focus:border-violet-500" placeholder="Try: React, Java, Bengaluru, Microsoft..." /><button class="px-6 py-3 rounded-2xl bg-white/10 hover:bg-white/15 transition font-semibold">Search</button></div></form>
<% if (!opportunities.length) { %><div class="glass rounded-3xl p-12 text-center"><div class="text-5xl">🔎</div><h2 class="text-xl font-bold mt-4">No opportunities found</h2><p class="text-gray-500 text-sm mt-2">Try a broader search or import fresh jobs.</p></div><% } else { %><div class="grid md:grid-cols-2 xl:grid-cols-3 gap-5"><% opportunities.forEach((item, index) => { %><article data-reveal class="glass hover-lift rounded-3xl p-6 flex flex-col"><div class="flex items-start justify-between gap-3"><div class="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 overflow-hidden grid place-items-center"><% if (item.logo) { %><img src="<%= item.logo %>" alt="" class="w-8 h-8 object-contain" onerror="this.style.display='none';this.nextElementSibling.style.display='grid'" /><span style="display:none" class="font-bold">🏢</span><% } else { %><span>🏢</span><% } %></div><span class="text-xs px-2.5 py-1 rounded-full bg-violet-500/10 text-violet-300 border border-violet-500/20"><%= item.type || 'Opportunity' %></span></div><h2 class="text-xl font-bold mt-5"><%= item.companyName %></h2><p class="text-gray-300 mt-1"><%= item.role %></p><div class="space-y-2 mt-5 text-sm text-gray-500"><p>📍 <%= item.location || 'Remote' %></p><p>💰 <%= item.stipend || 'Not mentioned' %></p><p>⏱ <%= item.deadline || 'Apply ASAP' %></p></div><% if (item.skills && item.skills.length) { %><div class="flex flex-wrap gap-2 mt-5"><% item.skills.slice(0,5).forEach(skill => { %><span class="px-2.5 py-1 rounded-full bg-white/5 border border-white/5 text-xs text-gray-400"><%= skill %></span><% }) %></div><% } %><div class="grid grid-cols-2 gap-3 mt-auto pt-6"><a href="<%= item.applyLink %>" target="_blank" rel="noopener noreferrer" class="text-center rounded-xl py-2.5 bg-white/5 hover:bg-white/10 transition">Apply ↗</a><form action="/track/<%= item._id %>" method="POST"><button class="w-full rounded-xl py-2.5 bg-gradient-to-r from-violet-600 to-fuchsia-600 font-semibold">Track</button></form></div></article><% }) %></div><% } %>
</main></div></div><script src="/javascripts/script.js"></script></body></html>
