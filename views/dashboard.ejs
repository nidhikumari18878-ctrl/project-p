<!DOCTYPE html><html lang="en"><head><title>Dashboard — Placement Tracker</title><%- include('partials/head') %></head>
<body class="app-bg bg-black text-white min-h-screen">
<div class="flex min-h-screen"><%- include('partials/sidebar') %><div class="flex-1 min-w-0"><%- include('partials/mobileNav') %>
<main class="max-w-7xl mx-auto p-5 sm:p-8 lg:p-10">
  <header class="flex flex-col md:flex-row md:items-end justify-between gap-5 mb-8" data-reveal>
    <div><p class="text-violet-300 text-sm font-semibold uppercase tracking-[.18em]">Career command center</p><h1 class="text-3xl sm:text-4xl font-extrabold mt-2">Welcome back, <span class="gradient-text"><%= user.name %></span> 👋</h1><p class="text-gray-500 mt-2">Your latest placement activity, all in one view.</p></div>
    <div class="flex items-center gap-3"><a href="/application" class="btn-shine rounded-2xl px-5 py-3 bg-gradient-to-r from-violet-600 to-fuchsia-600 font-semibold">+ Add application</a><a href="/logout" class="rounded-2xl px-4 py-3 border border-white/10 text-gray-400 hover:text-white hover:bg-white/5 transition">Logout</a></div>
  </header>

  <section class="grid sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">
    <div data-reveal class="glass hover-lift rounded-3xl p-5"><div class="flex justify-between"><span class="w-11 h-11 rounded-2xl bg-violet-500/15 grid place-items-center text-xl">📄</span><span class="text-xs text-gray-500">All time</span></div><p data-count="<%= totalApplications %>" class="text-3xl font-extrabold mt-5">0</p><p class="text-gray-500 text-sm mt-1">Applications</p></div>
    <div data-reveal class="glass hover-lift rounded-3xl p-5"><div class="flex justify-between"><span class="w-11 h-11 rounded-2xl bg-blue-500/15 grid place-items-center text-xl">🎯</span><span class="text-xs text-gray-500">Pipeline</span></div><p data-count="<%= totalInterviews %>" class="text-3xl font-extrabold mt-5">0</p><p class="text-gray-500 text-sm mt-1">Interviews</p></div>
    <div data-reveal class="glass hover-lift rounded-3xl p-5"><div class="flex justify-between"><span class="w-11 h-11 rounded-2xl bg-emerald-500/15 grid place-items-center text-xl">🏆</span><span class="text-xs text-gray-500">Outcome</span></div><p data-count="<%= totalSelected %>" class="text-3xl font-extrabold mt-5">0</p><p class="text-gray-500 text-sm mt-1">Selected</p></div>
    <div data-reveal class="glass hover-lift rounded-3xl p-5"><div class="flex justify-between"><span class="w-11 h-11 rounded-2xl bg-fuchsia-500/15 grid place-items-center text-xl">🤖</span><span class="text-xs text-fuchsia-300"><%= resumeData ? resumeData.atsScore : 0 %>%</span></div><p class="text-2xl font-extrabold mt-5"><%= resumeData ? (resumeData.atsScore >= 80 ? 'Ready' : resumeData.atsScore >= 60 ? 'Improving' : 'Needs work') : 'Not analyzed' %></p><p class="text-gray-500 text-sm mt-1">Resume readiness</p></div>
  </section>

  <section class="grid lg:grid-cols-[1.5fr_.8fr] gap-6">
    <div data-reveal class="glass rounded-3xl p-6 overflow-hidden"><div class="flex items-center justify-between mb-5"><div><h2 class="text-xl font-bold">Recent applications</h2><p class="text-gray-500 text-sm mt-1">Your latest tracked opportunities.</p></div><a href="/application" class="text-sm text-violet-300 hover:text-white">View all →</a></div>
      <% if (!applications.length) { %><div class="border border-dashed border-white/10 rounded-2xl p-10 text-center"><div class="text-4xl">🚀</div><h3 class="font-semibold mt-3">Your pipeline is empty</h3><p class="text-gray-500 text-sm mt-1">Add your first application to start tracking progress.</p><a href="/application" class="inline-block mt-5 px-5 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 transition">Add application</a></div><% } else { %>
      <div class="overflow-x-auto"><table class="w-full min-w-[650px]"><thead><tr class="text-left text-xs uppercase tracking-wider text-gray-600 border-b border-white/10"><th class="pb-3">Company</th><th class="pb-3">Role</th><th class="pb-3">Updated</th><th class="pb-3">Status</th><th class="pb-3">Package</th></tr></thead><tbody><% applications.forEach((app) => { %><tr class="border-b border-white/5 last:border-0 hover:bg-white/[.025] transition"><td class="py-4 font-medium"><%= app.companyName %></td><td class="py-4 text-gray-400"><%= app.role %></td><td class="py-4 text-gray-500 text-sm"><%= app.updatedAt ? new Date(app.updatedAt).toLocaleDateString() : '-' %></td><td class="py-4"><span class="px-2.5 py-1 rounded-full text-xs bg-violet-500/10 text-violet-300 border border-violet-500/20"><%= app.status %></span></td><td class="py-4 text-gray-400"><%= app.package || '-' %></td></tr><% }) %></tbody></table></div><% } %>
    </div>

    <div class="space-y-6">
      <div data-reveal class="rounded-3xl p-6 bg-gradient-to-br from-violet-600 to-fuchsia-600 shadow-2xl shadow-violet-950/20"><div class="text-3xl">🤖</div><h2 class="text-xl font-bold mt-4">AI resume check</h2><p class="text-violet-100/80 text-sm leading-6 mt-2"><%= resumeData ? 'Your latest resume has an ATS score ready. Review missing skills and suggestions.' : 'Upload your PDF resume to get an ATS score and improvement plan.' %></p><a href="/resume" class="inline-flex mt-5 px-4 py-2.5 rounded-xl bg-black/20 border border-white/15 hover:bg-black/30 transition font-semibold"><%= resumeData ? 'Review analysis' : 'Analyze resume' %> →</a></div>
      <div data-reveal class="glass rounded-3xl p-6"><div class="flex justify-between items-center"><h3 class="font-bold">Pipeline snapshot</h3><span class="text-xs text-gray-500">Live</span></div><div class="space-y-4 mt-5"><div><div class="flex justify-between text-xs mb-2"><span class="text-gray-400">OA rounds</span><span><%= totalOA %></span></div><div class="h-2 bg-white/5 rounded-full overflow-hidden"><div class="h-full bg-blue-400 rounded-full" style="width:<%= totalApplications ? Math.min(totalOA / totalApplications * 100, 100) : 0 %>%"></div></div></div><div><div class="flex justify-between text-xs mb-2"><span class="text-gray-400">Interviews</span><span><%= totalInterviews %></span></div><div class="h-2 bg-white/5 rounded-full overflow-hidden"><div class="h-full bg-violet-400 rounded-full" style="width:<%= totalApplications ? Math.min(totalInterviews / totalApplications * 100, 100) : 0 %>%"></div></div></div><div><div class="flex justify-between text-xs mb-2"><span class="text-gray-400">Selected</span><span><%= totalSelected %></span></div><div class="h-2 bg-white/5 rounded-full overflow-hidden"><div class="h-full bg-emerald-400 rounded-full" style="width:<%= totalApplications ? Math.min(totalSelected / totalApplications * 100, 100) : 0 %>%"></div></div></div></div></div>
    </div>
  </section>
</main></div></div><script src="/javascripts/script.js"></script></body></html>
