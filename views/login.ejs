<!DOCTYPE html><html lang="en"><head><title>Login — Placement Tracker</title><%- include('partials/head') %></head>
<body class="app-bg min-h-screen bg-black text-white flex items-center justify-center p-4">
  <main class="w-full max-w-5xl grid md:grid-cols-2 glass rounded-[2rem] overflow-hidden border-white/10 reveal">
    <section class="hidden md:flex p-12 bg-gradient-to-br from-violet-600/20 via-transparent to-fuchsia-600/10 border-r border-white/10 flex-col justify-center"><a href="/" class="flex items-center gap-3"><span class="w-12 h-12 rounded-2xl bg-gradient-to-br from-violet-600 to-fuchsia-600 grid place-items-center font-bold">PT</span><strong>Placement Tracker</strong></a><h1 class="text-5xl font-extrabold mt-12 leading-tight">Your career workspace is waiting.</h1><p class="text-gray-400 leading-7 mt-5">Pick up where you left off and keep every placement task organized.</p><div class="mt-8 space-y-3 text-sm text-gray-300"><div class="glass rounded-2xl p-4">📌 Track applications without losing context</div><div class="glass rounded-2xl p-4">🤖 Turn your resume into actionable insights</div><div class="glass rounded-2xl p-4">🏢 Save opportunities worth following</div></div></section>
    <section class="p-7 sm:p-12 flex flex-col justify-center"><a href="/" class="md:hidden flex items-center gap-3 mb-10"><span class="w-10 h-10 rounded-xl bg-gradient-to-br from-violet-600 to-fuchsia-600 grid place-items-center font-bold">PT</span><strong>Placement Tracker</strong></a><h2 class="text-4xl font-extrabold">Welcome back</h2><p class="text-gray-400 mt-2">Sign in to continue your placement journey.</p>
      <% if (query && query.registered) { %><div data-toast class="toast mt-5 rounded-2xl border border-emerald-500/20 bg-emerald-500/10 text-emerald-300 px-4 py-3 text-sm">Account created successfully. You can log in now.</div><% } %>
      <% if (typeof error !== 'undefined' && error) { %><div data-toast class="toast mt-5 rounded-2xl border border-red-500/20 bg-red-500/10 text-red-300 px-4 py-3 text-sm"><%= error %></div><% } %>
      <form action="/login" method="POST" class="space-y-5 mt-8"><label class="block"><span class="text-sm text-gray-300">Email</span><input required type="email" name="email" autocomplete="email" placeholder="you@example.com" class="mt-2 w-full rounded-2xl bg-black/50 border border-white/10 px-5 py-4 outline-none focus:border-violet-500" /></label><label class="block"><span class="text-sm text-gray-300">Password</span><input required type="password" name="password" autocomplete="current-password" placeholder="••••••••" class="mt-2 w-full rounded-2xl bg-black/50 border border-white/10 px-5 py-4 outline-none focus:border-violet-500" /></label><button class="btn-shine w-full rounded-2xl py-4 bg-gradient-to-r from-violet-600 to-fuchsia-600 font-bold shadow-lg shadow-violet-900/20">Sign in</button></form>
      <p class="text-center text-gray-500 text-sm mt-7">New here? <a class="text-violet-300 hover:text-white" href="/register">Create an account</a></p>
    </section>
  </main><script src="/javascripts/script.js"></script>
</body></html>
