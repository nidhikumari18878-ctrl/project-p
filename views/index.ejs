<!DOCTYPE html><html lang="en"><head><title>Placement Tracker — Career Command Center</title><%- include('partials/head') %></head>
<body class="app-bg min-h-screen bg-black text-white overflow-x-hidden">
  <nav class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 py-5 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3"><span class="w-11 h-11 rounded-2xl bg-gradient-to-br from-violet-600 to-fuchsia-600 grid place-items-center font-extrabold shadow-lg">PT</span><span class="font-bold tracking-tight">Placement Tracker</span></a>
    <div class="flex gap-3"><a href="/login" class="px-5 py-2.5 rounded-xl border border-white/10 text-gray-300 hover:text-white hover:bg-white/5 transition">Login</a><a href="/register" class="btn-shine px-5 py-2.5 rounded-xl bg-gradient-to-r from-violet-600 to-fuchsia-600 font-semibold">Get Started</a></div>
  </nav>

  <main class="relative max-w-7xl mx-auto px-5 sm:px-8 pt-10 pb-24">
    <section class="grid lg:grid-cols-[1.1fr_.9fr] gap-12 items-center min-h-[76vh]">
      <div data-reveal>
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-violet-500/20 bg-violet-500/10 text-violet-300 text-xs font-semibold uppercase tracking-[.18em]">✦ AI-powered placement workspace</span>
        <h1 class="mt-6 text-5xl sm:text-6xl lg:text-7xl font-extrabold leading-[1.02] tracking-tight">Turn your placement hunt into a <span class="gradient-text">system.</span></h1>
        <p class="mt-6 text-gray-400 text-lg leading-8 max-w-2xl">Track applications, discover opportunities, analyze your resume with AI, and keep your preparation moving from one focused dashboard.</p>
        <div class="mt-8 flex flex-wrap gap-3"><a href="/register" class="btn-shine px-6 py-3.5 rounded-2xl bg-gradient-to-r from-violet-600 to-fuchsia-600 font-semibold shadow-xl shadow-violet-900/20">Build my tracker →</a><a href="#features" class="px-6 py-3.5 rounded-2xl border border-white/10 hover:bg-white/5 transition">Explore features</a></div>
        <div class="mt-9 flex flex-wrap gap-5 text-sm text-gray-500"><span>✓ Secure JWT login</span><span>✓ MongoDB backed</span><span>✓ AI resume insights</span></div>
      </div>
      <div data-reveal class="reveal-delay-2 relative">
        <div class="absolute -inset-8 bg-violet-600/10 blur-3xl rounded-full"></div>
        <div class="glass relative rounded-[2rem] p-5 sm:p-7 border-white/10">
          <div class="flex items-center justify-between mb-6"><div><p class="text-xs uppercase tracking-[.18em] text-gray-500">Live workspace</p><h2 class="text-xl font-bold mt-1">Placement overview</h2></div><span class="w-3 h-3 rounded-full bg-emerald-400 shadow-lg shadow-emerald-500/40"></span></div>
          <div class="grid grid-cols-2 gap-3"><div class="bg-white/[.04] border border-white/5 rounded-2xl p-4"><p class="text-gray-500 text-xs">Applications</p><p class="text-3xl font-bold mt-2">24</p><p class="text-emerald-400 text-xs mt-1">+8 this month</p></div><div class="bg-white/[.04] border border-white/5 rounded-2xl p-4"><p class="text-gray-500 text-xs">Interviews</p><p class="text-3xl font-bold mt-2">07</p><p class="text-violet-300 text-xs mt-1">Keep going</p></div><div class="col-span-2 bg-gradient-to-br from-violet-600/20 to-fuchsia-600/10 border border-violet-400/10 rounded-2xl p-5"><div class="flex justify-between items-end"><div><p class="text-gray-400 text-sm">Resume readiness</p><p class="text-4xl font-extrabold mt-1">82<span class="text-lg text-gray-500">/100</span></p></div><span class="text-3xl">🤖</span></div><div class="mt-4 h-2 rounded-full bg-black/40 overflow-hidden"><div class="h-full w-[82%] bg-gradient-to-r from-violet-500 to-fuchsia-500 rounded-full progress-sheen"></div></div></div></div>
        </div>
      </div>
    </section>

    <section id="features" class="grid md:grid-cols-3 gap-5 pt-10">
      <div data-reveal class="glass hover-lift rounded-3xl p-6"><span class="text-3xl">📌</span><h3 class="font-bold text-lg mt-4">Application CRM</h3><p class="text-gray-400 text-sm leading-6 mt-2">Store applications in MongoDB, update status, search, filter and keep notes in one place.</p></div>
      <div data-reveal class="glass hover-lift rounded-3xl p-6"><span class="text-3xl">📄</span><h3 class="font-bold text-lg mt-4">AI Resume Analyzer</h3><p class="text-gray-400 text-sm leading-6 mt-2">Upload a PDF and get an ATS score, detected skills, missing skills and actionable suggestions.</p></div>
      <div data-reveal class="glass hover-lift rounded-3xl p-6"><span class="text-3xl">🏢</span><h3 class="font-bold text-lg mt-4">Opportunity Hub</h3><p class="text-gray-400 text-sm leading-6 mt-2">Search opportunities by company, role, location or skill and track interesting ones instantly.</p></div>
    </section>
  </main>
  <script src="/javascripts/script.js"></script>
</body></html>
