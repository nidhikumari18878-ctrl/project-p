<!DOCTYPE html><html lang="en"><head><title>Analytics — Placement Tracker</title><%- include('partials/head') %></head>
<body class="app-bg bg-black text-white min-h-screen"><div class="flex min-h-screen"><%- include('partials/sidebar') %><div class="flex-1 min-w-0"><%- include('partials/mobileNav') %><main class="max-w-7xl mx-auto p-5 sm:p-8 lg:p-10">
<header data-reveal class="mb-8"><p class="text-violet-300 text-sm font-semibold uppercase tracking-[.18em]">Performance analytics</p><h1 class="text-3xl sm:text-4xl font-extrabold mt-2">Know your placement funnel 📈</h1><p class="text-gray-500 mt-2">A simple view of volume, outcomes and conversion.</p></header>
<div class="grid sm:grid-cols-3 gap-4 mb-6"><% [['Applications',total],['Selected',selected],['Rejected',rejected]].forEach(([label,value]) => { %><div data-reveal class="glass rounded-3xl p-6"><p data-count="<%= value %>" class="text-3xl font-extrabold">0</p><p class="text-gray-500 text-sm mt-1"><%= label %></p></div><% }) %></div>
<div class="grid lg:grid-cols-2 gap-6"><section data-reveal class="glass rounded-3xl p-6"><h2 class="font-bold text-lg">Status breakdown</h2><div class="space-y-4 mt-6"><% Object.entries(statusCounts).forEach(([status,count]) => { const pct=total?Math.round(count/total*100):0; %><div><div class="flex justify-between text-sm"><span><%= status %></span><span class="text-gray-500"><%= count %> · <%= pct %>%</span></div><div class="h-2 rounded-full bg-white/5 mt-2 overflow-hidden"><div class="h-full bg-gradient-to-r from-violet-500 to-fuchsia-500 rounded-full" style="width:<%= pct %>%"></div></div></div><% }) %></div></section><section data-reveal class="glass rounded-3xl p-6"><h2 class="font-bold text-lg">Monthly activity</h2><div class="space-y-3 mt-6"><% Object.entries(monthly).slice(-8).forEach(([month,count]) => { const pct=total?Math.round(count/total*100):0; %><div class="flex items-center gap-3"><span class="w-24 text-sm text-gray-400"><%= month %></span><div class="flex-1 h-8 bg-white/5 rounded-xl overflow-hidden"><div class="h-full bg-gradient-to-r from-violet-600/80 to-fuchsia-600/80 flex items-center px-3 text-xs font-semibold" style="width:<%= Math.max(pct, 8) %>%"><%= count %></div></div></div><% }) %><% if (!Object.keys(monthly).length) { %><p class="text-gray-500">Apply to your first opportunity to see activity here.</p><% } %></div></section></div>
</main></div></div><script src="/javascripts/script.js"></script></body></html>
