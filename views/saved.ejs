<!DOCTYPE html><html lang="en"><head><title>Saved Jobs — Placement Tracker</title><%- include('partials/head') %></head>
<body class="app-bg bg-black text-white min-h-screen"><div class="flex min-h-screen"><%- include('partials/sidebar') %><div class="flex-1 min-w-0"><%- include('partials/mobileNav') %><main class="max-w-7xl mx-auto p-5 sm:p-8 lg:p-10">
<header data-reveal class="mb-8"><p class="text-violet-300 text-sm font-semibold uppercase tracking-[.18em]">Your shortlist</p><h1 class="text-3xl sm:text-4xl font-extrabold mt-2">Saved opportunities ⭐</h1><p class="text-gray-500 mt-2">Keep promising roles ready until you are prepared to apply.</p></header>
<% if (!saved.length) { %><div data-reveal class="glass rounded-3xl p-12 text-center"><div class="text-5xl">⭐</div><h2 class="text-xl font-bold mt-4">Nothing saved yet</h2><p class="text-gray-500 mt-2">Save opportunities from the Opportunities page.</p><a href="/opportunities" class="inline-block mt-6 rounded-xl px-5 py-3 bg-gradient-to-r from-violet-600 to-fuchsia-600 font-semibold">Browse jobs</a></div><% } else { %><div class="grid md:grid-cols-2 xl:grid-cols-3 gap-5"><% saved.forEach(({opportunity}) => { %><article data-reveal class="glass hover-lift rounded-3xl p-6"><div class="flex justify-between"><span class="text-2xl">🏢</span><form action="/saved/<%= opportunity._id %>/toggle" method="POST"><button class="text-yellow-300">★</button></form></div><h2 class="text-xl font-bold mt-5"><%= opportunity.companyName %></h2><p class="text-gray-300 mt-1"><%= opportunity.role %></p><p class="text-gray-500 text-sm mt-4">📍 <%= opportunity.location || 'Remote' %></p><div class="flex gap-2 mt-6"><a href="<%= opportunity.applyLink %>" target="_blank" rel="noopener noreferrer" class="flex-1 text-center rounded-xl py-2.5 bg-white/5 hover:bg-white/10">Apply ↗</a><a href="/opportunities/<%= opportunity._id %>/match" class="match-btn flex-1 text-center rounded-xl py-2.5 bg-gradient-to-r from-violet-600 to-fuchsia-600 font-semibold" data-match-id="<%= opportunity._id %>">AI Match</a></div><div class="match-result hidden mt-4 rounded-2xl bg-white/5 p-4 text-sm"></div></article><% }) %></div><% } %>
</main></div></div><script src="/javascripts/script.js"></script></body></html>
