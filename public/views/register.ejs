<!DOCTYPE html><html lang="en"><head><title>Create account — Placement Tracker</title><%- include('partials/head') %></head>
<body class="app-bg min-h-screen bg-black text-white flex items-center justify-center p-4">
  <main class="w-full max-w-5xl grid md:grid-cols-2 glass rounded-[2rem] overflow-hidden border-white/10 reveal">
    <section class="hidden md:flex p-12 bg-gradient-to-br from-violet-600/20 via-transparent to-fuchsia-600/10 border-r border-white/10 flex-col justify-center"><a href="/" class="flex items-center gap-3"><span class="w-12 h-12 rounded-2xl bg-gradient-to-br from-violet-600 to-fuchsia-600 grid place-items-center font-bold">PT</span><strong>Placement Tracker</strong></a><h1 class="text-5xl font-extrabold mt-12 leading-tight">Build your placement cockpit.</h1><p class="text-gray-400 leading-7 mt-5">One account for applications, opportunities, resume insights and your career progress.</p></section>
    <section class="p-7 sm:p-12 flex flex-col justify-center"><a href="/" class="md:hidden flex items-center gap-3 mb-10"><span class="w-10 h-10 rounded-xl bg-gradient-to-br from-violet-600 to-fuchsia-600 grid place-items-center font-bold">PT</span><strong>Placement Tracker</strong></a><h2 class="text-4xl font-extrabold">Create account</h2><p class="text-gray-400 mt-2">Start organizing your placement journey.</p>
      <% if (typeof error !== 'undefined' && error) { %><div data-toast class="toast mt-5 rounded-2xl border border-red-500/20 bg-red-500/10 text-red-300 px-4 py-3 text-sm"><%= error %></div><% } %>
      <form action="/register" method="POST" class="space-y-4 mt-8"><label class="block"><span class="text-sm text-gray-300">Full name</span><input required minlength="2" type="text" name="name" autocomplete="name" placeholder="Your name" class="mt-2 w-full rounded-2xl bg-black/50 border border-white/10 px-5 py-4 outline-none focus:border-violet-500" /></label><label class="block"><span class="text-sm text-gray-300">Email</span><input required type="email" name="email" autocomplete="email" placeholder="you@example.com" class="mt-2 w-full rounded-2xl bg-black/50 border border-white/10 px-5 py-4 outline-none focus:border-violet-500" /></label><div class="grid sm:grid-cols-2 gap-4"><label class="block"><span class="text-sm text-gray-300">Password</span><input required minlength="6" type="password" name="password" autocomplete="new-password" placeholder="At least 6 chars" class="mt-2 w-full rounded-2xl bg-black/50 border border-white/10 px-5 py-4 outline-none focus:border-violet-500" /></label><label class="block"><span class="text-sm text-gray-300">Confirm</span><input required minlength="6" type="password" name="confirmPassword" autocomplete="new-password" placeholder="Repeat password" class="mt-2 w-full rounded-2xl bg-black/50 border border-white/10 px-5 py-4 outline-none focus:border-violet-500" /></label></div><button class="btn-shine w-full rounded-2xl py-4 bg-gradient-to-r from-violet-600 to-fuchsia-600 font-bold mt-2">Create account</button></form>
      <p class="text-center text-gray-500 text-sm mt-7">Already have an account? <a class="text-violet-300 hover:text-white" href="/login">Sign in</a></p>
    </section>
  </main><script src="/javascripts/script.js"></script>
</body></html>
