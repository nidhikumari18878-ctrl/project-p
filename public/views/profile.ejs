<!DOCTYPE html><html lang="en"><head><title>Profile — Placement Tracker</title><%- include('partials/head') %></head>
<body class="app-bg bg-black text-white min-h-screen"><div class="flex min-h-screen"><%- include('partials/sidebar') %><div class="flex-1 min-w-0"><%- include('partials/mobileNav') %><main class="max-w-5xl mx-auto p-5 sm:p-8 lg:p-10">
<div data-reveal class="glass rounded-[2rem] overflow-hidden"><div class="h-36 bg-gradient-to-r from-violet-700/50 via-fuchsia-600/20 to-transparent"></div><div class="px-6 sm:px-10 pb-10"><div class="flex flex-col sm:flex-row sm:items-end gap-5 -mt-14"><img src="<%= user.image %>" alt="Profile" class="w-28 h-28 rounded-3xl object-cover border-4 border-black bg-zinc-900 shadow-2xl" onerror="this.src='https://i.pravatar.cc/150?img=12'" /><div class="flex-1"><p class="text-violet-300 text-xs uppercase tracking-[.18em]">Student profile</p><h1 class="text-3xl font-extrabold mt-1"><%= user.name %></h1><p class="text-gray-500 mt-1"><%= user.email %></p></div><a href="/update-profile" class="px-5 py-3 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 transition">Edit profile</a></div>
<div class="grid sm:grid-cols-3 gap-4 mt-9"><div class="bg-white/[.03] border border-white/5 rounded-2xl p-5"><p class="text-3xl font-extrabold"><%= totalApplied %></p><p class="text-gray-500 text-sm mt-1">Applications</p></div><div class="bg-white/[.03] border border-white/5 rounded-2xl p-5"><p class="text-3xl font-extrabold"><%= totalInterview %></p><p class="text-gray-500 text-sm mt-1">Interviews</p></div><div class="bg-white/[.03] border border-white/5 rounded-2xl p-5"><p class="text-3xl font-extrabold"><%= totalSelected %></p><p class="text-gray-500 text-sm mt-1">Selected</p></div></div>
<div class="flex flex-wrap gap-3 mt-8"><a href="/dashboard" class="px-5 py-3 rounded-2xl bg-gradient-to-r from-violet-600 to-fuchsia-600 font-semibold">Go to dashboard</a><a href="/resume" class="px-5 py-3 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 transition">Resume AI</a><a href="/logout" class="px-5 py-3 rounded-2xl border border-red-500/15 text-red-300 hover:bg-red-500/10 transition">Logout</a></div>
</div></div>
</main></div></div><script src="/javascripts/script.js"></script></body></html>
