<!DOCTYPE html><html lang="en"><head><title>Edit profile — Placement Tracker</title><%- include('partials/head') %></head>
<body class="app-bg bg-black text-white min-h-screen flex items-center justify-center p-5"><main class="w-full max-w-xl glass rounded-[2rem] p-7 sm:p-10 reveal"><a href="/profile" class="text-gray-500 hover:text-white text-sm">← Back to profile</a><h1 class="text-3xl font-extrabold mt-6">Edit profile</h1><p class="text-gray-500 mt-2">Keep your account details current.</p><form action="/update-profile" method="POST" class="space-y-5 mt-8"><label class="block text-sm text-gray-300">Name<input required name="name" value="<%= user.name %>" class="field mt-2" /></label><label class="block text-sm text-gray-300">Email<input required type="email" name="email" value="<%= user.email %>" class="field mt-2" /></label><label class="block text-sm text-gray-300">Profile image URL<input type="url" name="image" value="<%= user.image %>" placeholder="https://..." class="field mt-2" /></label><div class="flex gap-3"><a href="/profile" class="flex-1 text-center rounded-2xl py-3 bg-white/5 hover:bg-white/10 transition">Cancel</a><button class="flex-1 rounded-2xl py-3 bg-gradient-to-r from-violet-600 to-fuchsia-600 font-bold">Save changes</button></div></form></main><style>.field{display:block;width:100%;background:rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.1);border-radius:1rem;padding:.9rem 1rem;color:white;outline:none}.field:focus{border-color:rgb(139 92 246)}</style><script src="/javascripts/script.js"></script></body></html>
