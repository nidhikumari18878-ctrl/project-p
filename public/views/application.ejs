<!DOCTYPE html><html lang="en"><head><title>Applications — Placement Tracker</title><%- include('partials/head') %></head>
<body class="app-bg bg-black text-white min-h-screen"><div class="flex min-h-screen"><%- include('partials/sidebar') %><div class="flex-1 min-w-0"><%- include('partials/mobileNav') %><main class="max-w-7xl mx-auto p-5 sm:p-8 lg:p-10">
<header data-reveal class="flex flex-col lg:flex-row lg:items-end justify-between gap-5 mb-8"><div><p class="text-violet-300 text-sm font-semibold uppercase tracking-[.18em]">Application CRM</p><h1 class="text-3xl sm:text-4xl font-extrabold mt-2">Your applications</h1><p class="text-gray-500 mt-2">Search, filter and update every opportunity from one place.</p></div><button id="openModalBtn" class="btn-shine px-5 py-3 rounded-2xl bg-gradient-to-r from-violet-600 to-fuchsia-600 font-semibold">+ Add application</button></header>
<% if (query && query.success) { %><div data-toast class="toast mb-5 rounded-2xl border border-emerald-500/20 bg-emerald-500/10 text-emerald-300 px-4 py-3 text-sm">Application updated successfully.</div><% } %><% if (query && query.error) { %><div data-toast class="toast mb-5 rounded-2xl border border-red-500/20 bg-red-500/10 text-red-300 px-4 py-3 text-sm">We couldn't complete that application action.</div><% } %>
<section class="grid sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-6"><% const counts = { Applied: applications.filter(a => a.status === 'Applied').length, 'OA Round': applications.filter(a => a.status === 'OA Round').length, Interview: applications.filter(a => a.status === 'Interview').length, Selected: applications.filter(a => a.status === 'Selected').length }; %><% [['📄','Applied',counts.Applied],['💻','OA Round',counts['OA Round']],['🎯','Interviews',counts.Interview],['🏆','Selected',counts.Selected]].forEach((item) => { %><div data-reveal class="glass hover-lift rounded-3xl p-5"><span class="text-2xl"><%= item[0] %></span><p data-count="<%= item[2] %>" class="text-3xl font-extrabold mt-4">0</p><p class="text-gray-500 text-sm mt-1"><%= item[1] %></p></div><% }) %></section>
<section data-reveal class="glass rounded-3xl p-5 sm:p-6 overflow-hidden"><div class="flex flex-col md:flex-row gap-3 justify-between mb-5"><div class="relative flex-1 max-w-xl"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-500">⌕</span><input id="searchInput" class="w-full bg-black/30 border border-white/10 rounded-2xl px-11 py-3 outline-none focus:border-violet-500" placeholder="Search company, role, location..." /></div><select id="statusFilter" class="bg-black/30 border border-white/10 rounded-2xl px-4 py-3 outline-none focus:border-violet-500"><option>All Status</option><% statuses.forEach((status) => { %><option><%= status %></option><% }) %></select></div>
<div class="overflow-x-auto"><table class="w-full min-w-[980px]"><thead><tr class="text-left text-xs uppercase tracking-wider text-gray-600 border-b border-white/10"><th class="pb-3">Company</th><th class="pb-3">Role</th><th class="pb-3">Updated</th><th class="pb-3">Status</th><th class="pb-3">Package</th><th class="pb-3">Note</th><th class="pb-3">Action</th></tr></thead><tbody id="applicationTableBody"><% applications.forEach((app) => { %><tr data-application-row data-status="<%= app.status %>" class="border-b border-white/5 hover:bg-white/[.025] transition"><td class="py-4 font-semibold"><%= app.companyName %><% if (app.location && app.location !== '-') { %><span class="block text-xs text-gray-600 font-normal mt-1">📍 <%= app.location %></span><% } %></td><td class="py-4 text-gray-400"><%= app.role %></td><td class="py-4 text-gray-500 text-sm"><%= app.updatedAt ? new Date(app.updatedAt).toLocaleDateString() : '-' %></td><td class="py-4"><form action="/application/<%= app._id %>/status" method="POST"><select name="status" onchange="this.form.submit()" class="bg-violet-500/10 text-violet-300 border border-violet-500/20 rounded-xl px-3 py-2 outline-none"><% statuses.forEach((status) => { %><option <%= app.status === status ? 'selected' : '' %>><%= status %></option><% }) %></select></form></td><td class="py-4 text-gray-400"><%= app.package || '-' %></td><td class="py-4 text-gray-500 max-w-[220px] truncate"><%= app.note || '-' %></td><td class="py-4"><form action="/application/<%= app._id %>/delete" method="POST" onsubmit="return confirm('Delete this application?');"><button class="text-red-300 hover:text-red-200 text-sm">Delete</button></form></td></tr><% }) %></tbody></table></div><div id="applicationEmptyState" class="hidden py-10 text-center text-gray-500">No applications match your search/filter.</div><% if (!applications.length) { %><div class="py-12 text-center"><div class="text-4xl">📌</div><h3 class="font-semibold mt-3">No applications yet</h3><p class="text-gray-500 text-sm mt-1">Add one manually or track an opportunity.</p></div><% } %></section>
</main></div></div>
<div id="applicationModal" class="modal-backdrop fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden items-center justify-center p-4"><div class="modal-card w-full max-w-2xl glass rounded-[2rem] p-6 sm:p-8 max-h-[92vh] overflow-y-auto"><div class="flex justify-between gap-4 mb-7"><div><p class="text-violet-300 text-xs uppercase tracking-[.18em]">New record</p><h2 class="text-2xl font-extrabold mt-1">Add application</h2></div><button data-close-modal class="w-10 h-10 rounded-xl bg-white/5 hover:bg-white/10">✕</button></div><form action="/application" method="POST" class="space-y-5"><div class="grid md:grid-cols-2 gap-4"><label>Company<input required name="companyName" placeholder="Infosys" class="mt-2 field" /></label><label>Role<input required name="role" placeholder="Frontend Developer" class="mt-2 field" /></label><label>Location<input name="location" placeholder="Bengaluru / Remote" class="mt-2 field" /></label><label>Package<input name="package" placeholder="₹6 LPA" class="mt-2 field" /></label></div><label>Status<select name="status" class="mt-2 field"><% statuses.forEach((status) => { %><option><%= status %></option><% }) %></select></label><div class="grid md:grid-cols-2 gap-4"><label>Interview date/time<input type="datetime-local" name="interviewDate" class="mt-2 field" /></label><label>Application deadline<input type="date" name="deadline" class="mt-2 field" /></label></div><label>Note<textarea name="note" rows="3" placeholder="Recruiter details, next step, deadline..." class="mt-2 field resize-none"></textarea></label><button class="btn-shine w-full rounded-2xl py-3.5 bg-gradient-to-r from-violet-600 to-fuchsia-600 font-bold">Save application</button></form></div></div>
<style>.field{display:block;width:100%;background:rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.1);border-radius:1rem;padding:.9rem 1rem;color:white;outline:none}.field:focus{border-color:rgb(139 92 246)}label{display:block;font-size:.875rem;color:#d1d5db}</style><script src="/javascripts/script.js"></script></body></html>
