<!DOCTYPE html><html lang="en"><head><title>Calendar — Placement Tracker</title><%- include('partials/head') %></head>
<body class="app-bg bg-black text-white min-h-screen"><div class="flex min-h-screen"><%- include('partials/sidebar') %><div class="flex-1 min-w-0"><%- include('partials/mobileNav') %><main class="max-w-6xl mx-auto p-5 sm:p-8 lg:p-10">
<header data-reveal class="mb-8"><p class="text-violet-300 text-sm font-semibold uppercase tracking-[.18em]">Placement calendar</p><h1 class="text-3xl sm:text-4xl font-extrabold mt-2">Never miss your next step 📅</h1><p class="text-gray-500 mt-2">Interview dates and application deadlines from your tracker.</p></header>
<% if (!applications.length) { %><div class="glass rounded-3xl p-12 text-center" data-reveal><div class="text-5xl">🗓️</div><h2 class="text-xl font-bold mt-4">Your calendar is clear</h2><p class="text-gray-500 mt-2">Add interview or deadline dates while creating an application.</p><a href="/application" class="inline-block mt-6 rounded-xl px-5 py-3 bg-gradient-to-r from-violet-600 to-fuchsia-600 font-semibold">Add application</a></div><% } else { %>
<div class="grid md:grid-cols-2 gap-5"><% applications.forEach((app) => { %><article data-reveal class="glass hover-lift rounded-3xl p-6"><div class="flex justify-between gap-4"><div><h2 class="font-bold text-lg"><%= app.companyName %></h2><p class="text-gray-400 text-sm mt-1"><%= app.role %></p></div><span class="text-xs px-2.5 py-1 h-fit rounded-full bg-violet-500/10 text-violet-300 border border-violet-500/20"><%= app.status %></span></div><div class="grid sm:grid-cols-2 gap-3 mt-6"><% if (app.interviewDate) { %><div class="rounded-2xl bg-violet-500/10 border border-violet-500/10 p-4"><p class="text-xs text-violet-300 uppercase tracking-wider">Interview</p><p class="font-semibold mt-1"><%= new Date(app.interviewDate).toLocaleString('en-IN',{dateStyle:'medium',timeStyle:'short'}) %></p></div><% } %><% if (app.deadline) { %><div class="rounded-2xl bg-fuchsia-500/10 border border-fuchsia-500/10 p-4"><p class="text-xs text-fuchsia-300 uppercase tracking-wider">Deadline</p><p class="font-semibold mt-1"><%= new Date(app.deadline).toLocaleDateString('en-IN',{dateStyle:'medium'}) %></p></div><% } %></div></article><% }) %></div><% } %>
</main></div></div><script src="/javascripts/script.js"></script></body></html>
