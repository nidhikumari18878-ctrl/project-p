<!DOCTYPE html><html lang="en"><head><title>Resume AI — Placement Tracker</title><%- include('partials/head') %></head>
<body class="app-bg bg-black text-white min-h-screen"><div class="flex min-h-screen"><%- include('partials/sidebar') %><div class="flex-1 min-w-0"><%- include('partials/mobileNav') %><main class="max-w-7xl mx-auto p-5 sm:p-8 lg:p-10">
<header data-reveal class="mb-8"><p class="text-violet-300 text-sm font-semibold uppercase tracking-[.18em]">AI resume lab</p><h1 class="text-3xl sm:text-4xl font-extrabold mt-2">Resume analyzer</h1><p class="text-gray-500 mt-2">Upload a PDF and get an ATS-oriented snapshot with practical next steps.</p></header>
<% if (query && query.success) { %><div data-toast class="toast mb-5 rounded-2xl border border-emerald-500/20 bg-emerald-500/10 text-emerald-300 px-4 py-3 text-sm">Resume analyzed successfully.</div><% } %><% if (query && query.error) { %><div data-toast class="toast mb-5 rounded-2xl border border-red-500/20 bg-red-500/10 text-red-300 px-4 py-3 text-sm"><%= query.error === 'ai' ? 'AI analysis is not configured. Add GEMINI_API_KEY to your environment.' : query.error === 'empty' ? 'The PDF did not contain readable text.' : 'Resume upload or analysis failed. Please try again.' %></div><% } %>
<section data-reveal class="glass rounded-[2rem] p-6 sm:p-8 mb-6"><form action="/upload-resume" method="POST" enctype="multipart/form-data" class="grid lg:grid-cols-[1fr_auto] gap-5 items-end"><label class="block"><span class="text-sm text-gray-300">Resume PDF <span class="text-gray-600">(max 5 MB)</span></span><div class="mt-2 border border-dashed border-violet-500/30 rounded-2xl p-4 bg-violet-500/[.04]"><input id="resumeFile" required type="file" accept="application/pdf,.pdf" name="resume" class="w-full text-sm text-gray-400 file:mr-4 file:rounded-xl file:border-0 file:bg-violet-600 file:text-white file:px-4 file:py-2 file:font-semibold" /><p id="resumeFileName" class="text-xs text-gray-600 mt-2">No file selected</p></div></label><button class="btn-shine px-7 py-3.5 rounded-2xl bg-gradient-to-r from-violet-600 to-fuchsia-600 font-bold">Analyze with AI →</button></form></section>
<% if (!resumeData) { %><section class="glass rounded-[2rem] p-12 text-center"><div class="text-5xl">📄</div><h2 class="text-2xl font-bold mt-4">No resume analysis yet</h2><p class="text-gray-500 max-w-lg mx-auto mt-2">Upload your latest PDF above. Your analysis will be saved to your account so you can review it later.</p></section><% } else { %>
<section class="grid lg:grid-cols-3 gap-5 mb-6"><div data-reveal class="glass rounded-3xl p-7"><div class="flex items-center justify-between"><h2 class="font-bold">ATS score</h2><span class="text-xs text-gray-500">Latest</span></div><div class="flex items-end gap-2 mt-7"><span class="text-6xl font-extrabold gradient-text"><%= resumeData.atsScore %></span><span class="text-gray-500 mb-2">/ 100</span></div><div class="h-3 bg-white/5 rounded-full overflow-hidden mt-6"><div data-score-progress="<%= resumeData.atsScore %>" class="h-full bg-gradient-to-r from-violet-500 to-fuchsia-500 rounded-full progress-sheen" style="width:0"></div></div><p class="text-sm text-gray-500 mt-4"><%= resumeData.atsScore >= 80 ? 'Strong resume signal.' : resumeData.atsScore >= 60 ? 'Good base with room to improve.' : 'Focus on the suggestions below.' %></p></div>
<div data-reveal class="glass rounded-3xl p-7"><h2 class="font-bold">Detected skills</h2><div class="flex flex-wrap gap-2 mt-5"><% if (resumeData.skills.length) { resumeData.skills.forEach(skill => { %><span class="px-3 py-2 rounded-xl bg-emerald-500/10 border border-emerald-500/15 text-emerald-300 text-sm"><%= skill %> ✓</span><% }) } else { %><span class="text-gray-500 text-sm">No skills detected.</span><% } %></div></div>
<div data-reveal class="rounded-3xl p-7 bg-gradient-to-br from-violet-600 to-fuchsia-600"><div class="text-4xl">🤖</div><h2 class="text-xl font-bold mt-4">AI summary</h2><p class="text-violet-100/80 text-sm leading-6 mt-2"><%= resumeData.suggestions[0] || 'Review the detailed recommendations below.' %></p></div></section>
<section class="grid lg:grid-cols-2 gap-5"><div data-reveal class="glass rounded-3xl p-7"><div class="flex justify-between"><h2 class="text-xl font-bold">Missing skills</h2><span class="text-xs text-gray-500">Recommended</span></div><div class="space-y-3 mt-5"><% if (resumeData.missingSkills.length) { resumeData.missingSkills.forEach(skill => { %><div class="flex gap-3 items-center p-3 rounded-2xl bg-red-500/5 border border-red-500/10 text-red-300"><span>↗</span><span><%= skill %></span></div><% }) } else { %><p class="text-gray-500 text-sm">No missing skills were returned by the analyzer.</p><% } %></div></div><div data-reveal class="glass rounded-3xl p-7"><h2 class="text-xl font-bold">Action plan</h2><div class="space-y-3 mt-5"><% if (resumeData.suggestions.length) { resumeData.suggestions.forEach((suggestion, index) => { %><div class="flex gap-3 p-3 rounded-2xl bg-white/[.03] border border-white/5"><span class="w-7 h-7 shrink-0 rounded-lg bg-violet-500/15 text-violet-300 grid place-items-center text-xs font-bold"><%= index + 1 %></span><p class="text-sm text-gray-300 leading-6"><%= suggestion %></p></div><% }) } else { %><p class="text-gray-500 text-sm">No suggestions available.</p><% } %></div></div></section><% } %>
</main></div></div><script src="/javascripts/script.js"></script></body></html>
